{
    "name": "mmskazak/laravel-soap",
    "description": "A SoapClient wrapper integration for Laravel (PHP 8.0+ fork of artisaninweb/laravel-soap)",
    "keywords": ["laravel", "soap", "client", "wrapper"],
    "license": "MIT",
    "authors": [
        {
            "name": "Michael van de Rijt",
            "email": "me@mvdrijt.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-soap": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Artisaninweb\\SoapWrapper\\": "src/Artisaninweb/SoapWrapper/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Artisaninweb\\SoapWrapper\\ServiceProvider"
            ],
            "aliases": {
                "SoapWrapper": "Artisaninweb\\SoapWrapper\\Facade"
            }
        }
    }
}
